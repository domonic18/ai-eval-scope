# ============================================================
# Agent Eval System 环境变量配置
# ============================================================
#
# 使用方法:
#   cp .env.example .env
#   按需修改 .env 中的配置值
#
# 适用范围:
#   [评估器]    Python CLI（agent-eval eval）与 ResultSink
#   [平台后端]  可观测平台 Express 后端（web/backend）
#   [基础设施]  docker compose 起栈的 postgres / minio 容器
#   [executor]  评测执行服务（eval-executor，SCF 事件函数镜像，docs/arch/14）
#
# 配置优先级: 环境变量 > .env > 代码默认值（agent_eval/config、web/backend/src/config）
#
# 单一配置源 & 去重:
#   - 数据库凭据只在 [4] 写一次（POSTGRES_*）；PLATFORM_DATABASE_URL 由 compose 拼接（容器内 host=postgres）。
#   - 对象存储凭据只在 [5] 写一次（MINIO_ROOT_* = S3 access/secret）；PLATFORM_S3_ACCESS_KEY/SECRET_KEY/ENDPOINT 由 compose 派生。
#   - host 直跑后端时，需自行 export PLATFORM_DATABASE_URL / PLATFORM_S3_*（见文末速查）。


# ============================================================
# [1] LLM Provider API Key [评估器]  (评估必填)
# ============================================================
# 评估器 LLM Judge 用。llm_config.yaml 以 ${DEEPSEEK_API_KEY} 等引用。按需配置，不用留空。
DEEPSEEK_API_KEY=              # 默认 Judge Provider
KIMI_API_KEY=                  # 视觉评估 Provider（可选）
# OPENAI_API_KEY=              # 可选备选


# ============================================================
# [2] Langfuse 追踪 [评估器]  (可选)
# ============================================================
# 记录 LLM 调用链（trace/span）；留空禁用。注册 https://cloud.langfuse.com 获取。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


# ============================================================
# [3] 可观测平台对接（ResultSink）[评估器]  (可选)
# ============================================================
# agent-eval eval 完成后自动把结果推送到可观测平台。
# 凭据在「项目详情 → API Keys → 签发新 Key」获取（单一 Bearer Key，仅显示一次）。
# 未配置或 AGENT_EVAL_UPLOAD!=true → 静默跳过。
AGENT_EVAL_HOST=http://localhost:9000     # 平台地址（本地 :9000；docker compose 同此）
AGENT_EVAL_API_KEY=                       # 单一 Bearer Key（eval-…）
AGENT_EVAL_UPLOAD=true                    # 自动上报（CLI --upload/--no-upload 可覆盖）
# AGENT_EVAL_QUEUE_DIR=                   # 离线队列目录（默认 <workspace>/.ingest_queue）


# ============================================================
# [4] 数据库 [平台后端 + 基础设施]  (必须 — 单一凭据源)
# ============================================================
# 同时供 postgres 容器初始化 与 平台后端连接。PLATFORM_DATABASE_URL 由 compose 拼接：
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
# 迁移云库：改这三项即可。
POSTGRES_USER=eval
POSTGRES_PASSWORD=evalpassword
POSTGRES_DB=agent_eval


# ============================================================
# [5] 对象存储 [平台后端 + 基础设施]  (必须 — 单一凭据源)
# ============================================================
# minio（本地 docker compose）/ s3 / cos（腾讯云）。迁移 COS 见 docs/arch/09 §12.2。
# MINIO_ROOT_* 既是 minio 容器 root 凭据，也是平台 S3 access/secret（compose 派生）。
# 容器内 PLATFORM_S3_ENDPOINT 由 compose 设为 http://minio:9000，不在本文件维护。
PLATFORM_OBJECT_STORAGE=minio
PLATFORM_S3_REGION=us-east-1
PLATFORM_S3_BUCKET=agent-eval
PLATFORM_S3_PATH_STYLE=true              # MinIO 需 true；AWS S3 通常 false
MINIO_ROOT_USER=eval                     # = S3 access key；COS 时填 SecretId
MINIO_ROOT_PASSWORD=evalpassword123      # = S3 secret key；COS 时填 SecretKey

# presigned URL 对外端点（上传/下载方需可达；MinIO 严格校验签名 Host）。
# 本地 docker：minio 映射宿主 9100 → http://localhost:9100（CLI/浏览器可达）。
# 测试 executor（容器内下载输入/上传制品）时改 http://minio:9000 + 重启 web。
# 生产 COS：公网域名（CLI/executor/浏览器都可达）。
PLATFORM_S3_EXTERNAL_ENDPOINT=http://localhost:9100


# ============================================================
# [6] 安全与密钥 [平台后端]  (生产必须替换)
# ============================================================
# 生成强随机: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_JWT_SECRET=                     # JWT 签名密钥
PLATFORM_KEY_ENCRYPTION_KEY=             # API Key token 对称加密密钥（AES-256-GCM，executor 回传解密用）
PLATFORM_ALLOW_SIGNUP=true               # 是否开放注册

# ── SCF executor 触发（评测执行；docs/arch/14）──
# 本地 docker compose：SCF_ENABLED=false，executor 以 worker 模式轮询 eval_jobs。
# 生产：SCF_ENABLED=true，Web 经 SCF Invoke Event 触发 executor（事件函数 + Job 镜像 + 异步执行）。
SCF_ENABLED=false
SCF_REGION=ap-guangzhou
SCF_NAMESPACE=default
SCF_EXECUTOR_FUNCTION_NAME=agent-eval-executor
TENCENT_SECRET_ID=                       # 腾讯云 API 密钥（SCF Invoke 签名；SCF_ENABLED=true 时必填）
TENCENT_SECRET_KEY=


# ============================================================
# [7] 摄取与业务参数 [平台后端]  (可选，保持默认即可)
# ============================================================
PLATFORM_INGEST_RATE_LIMIT=600           # 每 key 每分钟配额
PLATFORM_INGEST_MAX_BATCH=500            # 单批事件数上限
PLATFORM_INGEST_MAX_BYTES=4194304        # 单批体积上限（4MB）
PLATFORM_PRESIGN_TTL_SEC=900             # presigned URL 有效期（秒，≤900）
PLATFORM_RETENTION_DEFAULT_DAYS=90       # 项目默认保留期
LOG_LEVEL=info                           # trace | debug | info | warn | error
WORKSPACE_DIR=workspace                  # 工作目录（runs/reports/cache/queue；相对 CWD）


# ============================================================
# [8] Executor 评测执行服务 [executor]  (可选，保持默认即可)
# ============================================================
# eval-executor 为 SCF 事件函数镜像（Job 镜像 + 异步执行，最长 24h）。DB 复用 [4]；
# eval_jobs 表在 public schema（由 make db-init 创建，executor 不建库）。
# 鉴权复用 [6] PLATFORM_KEY_ENCRYPTION_KEY 解密 api_keys.token_encrypted（单一 Bearer token）。
# 评估结果回传复用 [3] AGENT_EVAL_*（per-job 用第三方 token 回传 → 落到第三方项目）。
# 本地 worker 模式由 docker-compose 设 EVALEXECUTOR_WORKER_ENABLED=true。
# EVALEXECUTOR_WORKER_CONCURRENCY=2
# EVALEXECUTOR_WEB_BASE_URL=http://localhost:9000
# EVALEXECUTOR_WORKSPACE=/tmp/executor-workspace
# EVALEXECUTOR_POLL_INTERVAL_SEC=1
# EVALEXECUTOR_HTTP_TIMEOUT_SEC=120


# ============================================================
# [9] SAML SSO 登录 [平台后端]  (可选)
# ============================================================
# 接入公司统一 IdP；未启用（SAML_SSO_ENABLED=false）时登录页不显示 SSO Tab，邮箱登录照常。
SAML_SSO_ENABLED=false

# SP（本平台侧；生产填实际域名）
SAML_SP_ENTITY_ID=
SAML_ACS_URL=
SAML_SLS_URL=
SAML_SP_CERT=                            # 可选（IdP 不强制签名请求时留空）
SAML_SP_KEY=

# IdP（公司 IdP 侧，公开值）
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLS_URL=
SAML_IDP_CERT=                           # IdP 公钥证书（纯 base64 可，后端自动补 PEM 头）

SAML_STRICT=true
SAML_DEBUG=false
