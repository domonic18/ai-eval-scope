# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/

# Environment variables & secrets (never commit)
.env
.secret

# User LLM config (contains API keys)
llm_config.yaml

# IDE
.idea/
.vscode/

# Claude Code
.claude/
*.swp
*.swo

# Testing
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Runtime data (not version controlled)
workspace/
packages/

# OS
.DS_Store
Thumbs.db
*.zip

# Ruff
.ruff_cache/

# mypy
.mypy_cache/

# Web Portal (Node.js build artifacts)
web/backend/node_modules/
web/frontend/node_modules/
web/frontend/dist/
web/backend/public/

# Prisma 项目根污染：schema.prisma 迁至 db/web/prisma/ 后，prisma generate 会把仓库根
# 推断为项目根并在此安装 @prisma/client/prisma（node_modules + package.json）。
# 这是 Prisma 的推断副作用，非本项目依赖，勿入库。详见 db/README.md。
/package.json
/package-lock.json
/node_modules/

# 可观测平台离线摄取队列（运行期产物）
.ingest_queue/

# llm_config.yaml 不落根目录（防明文 key 入库）
/llm_config.yaml
# evaluator 包内默认配置：仅 ${VAR} 引用、无明文 key，入库供 CI 构建使用（参考 .example.yaml）
!evaluator/agent_eval/assets/configs/llm_config.yaml
